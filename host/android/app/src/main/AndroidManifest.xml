<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 后台音频:切 tab/退到后台时 ExoPlayer 继续播(对齐 iOS 后台播放)。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 媒体前台服务(MediaSessionService):媒体通知 + 息屏不被杀。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+ 需要运行时授权才能显示媒体通知。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 客户端更新:交系统安装器需要声明安装包权限(用户仍需勾选允许)。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- `usesCleartextTraffic`: the dev/QA flow loads bundles over plain HTTP
         on the LAN (alignment collection against a laptop server). The hot
         update pipeline (stage 4c) will pin its endpoints to HTTPS. -->
    <application
        android:name=".HostApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PomeloLynx"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|locale|layoutDirection|smallestScreenSize|screenLayout|density"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 媒体前台服务:提供通知栏/锁屏控制,保证息屏后继续播放。
             intent-filter 必需(media3 用它绑定 controller)。 -->
        <service
            android:name=".media.PomeloPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- PomeloPlatform.shareFile:把 cacheDir/share 下的临时文件通过
             content:// URI 交给系统分享面板。authority 必须与
             PomeloPlatformModule 里的 `${applicationId}.fileprovider` 一致。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
