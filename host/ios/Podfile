source 'https://cdn.cocoapods.org/'

platform :ios, '15.0'

# 本地开发版:带 Inspector(Devtool),bundle id org.pomelo.lynx。
project 'PomeloLynx.xcodeproj'
workspace 'PomeloLynx'

require_relative 'pods'
extend PomeloPods

target 'PomeloLynx' do
  pomelo_pods(devtools: true)
end

post_install do |installer|
  PomeloPods.apply_build_settings(installer)
end
