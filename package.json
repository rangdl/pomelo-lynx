{
  "name": "pomelo-lynx",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "rspeedy build && node scripts/assert-bundle-fresh.mjs",
    "build:host": "pnpm run build && node scripts/gen-native-host.mjs && node scripts/copy-bundle-android.mjs && node scripts/copy-bundle-ios.mjs",
    "build:lynx": "rspeedy build --environment lynx",
    "build:web": "rspeedy build --environment web",
    "check": "biome check --write",
    "check:ios": "node --test scripts/__tests__/ios-native-contract.node-test.mjs",
    "lint": "biome ci --error-on-warnings",
    "dev": "rspeedy dev",
    "e2e": "rstest run -c rstest.e2e.config.ts",
    "e2e:collect": "bash e2e/alignment/collect.sh",
    "e2e:diff": "python3 e2e/alignment/diff.py",
    "e2e:native": "E2E_PLATFORM=native pnpm run e2e",
    "e2e:web": "E2E_PLATFORM=web pnpm run e2e",
    "format": "biome format --write",
    "preview": "rspeedy preview",
    "release:major": "pnpm version major",
    "release:minor": "pnpm version minor",
    "release:patch": "pnpm version patch",
    "test": "rstest run && node --test scripts/__tests__/*.node-test.mjs",
    "typecheck": "tsc -b",
    "verify:web": "pnpm run build && pnpm run e2e:web",
    "version": "node scripts/sync-native-version.mjs && git add host/ios/PomeloLynx.xcodeproj/project.pbxproj",
    "web:dev": "rspeedy preview"
  },
  "dependencies": {
    "@lynx-js/react": "^0.128.0",
    "@lynx-js/web-core": "^0.26.4",
    "@tanstack/react-router": "^1.170.46",
    "url-search-params-polyfill": "^8.2.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@lynx-js/preact-devtools": "^5.0.1-20260827072047-5f77e12",
    "@lynx-js/qrcode-rsbuild-plugin": "^0.7.3",
    "@lynx-js/react-rsbuild-plugin": "^0.21.0",
    "@lynx-js/rspeedy": "^0.18.0",
    "@lynx-js/types": "^4.3.0",
    "@lynx-js/web-platform-rsbuild-plugin": "^0.1.2",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rstest/core": "^0.12.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "agent-lynx": "^0.14.17",
    "jsdom": "^27.4.0",
    "playwright-core": "^1.64.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "private": true
}
