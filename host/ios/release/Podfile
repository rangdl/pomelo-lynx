# 私有源与开发版一致(见 ../Podfile 的说明):Lynx / XElement 由官方
# lynx-family/Specs.git 发布,trunk 提供公共包。
source 'https://github.com/lynx-family/Specs.git'
source 'https://cdn.cocoapods.org/'

platform :ios, '15.0'

plugin 'cocoapods-lynx-library'

# CI 正式发版(tag 构建)专用:不带 LynxService/Devtool,编译更快、体积更小。
# dev 通道(master push)改用顶层 Podfile + Debug configuration,自带
# Inspector。与本地开发版可同时安装:tag 构建为 org.pomelo.lynx(Release
# configuration),dev/本地构建为 org.pomelo.lynx.debug(Debug configuration)。
#
# 与开发版共用同一个 Pods 沙盒,这样工程里已有的 CocoaPods xcconfig
# 引用在两套 graph 之间切换时仍然有效。
Pod::Config.instance.sandbox_root = Pathname.new(__dir__).parent.join('Pods')

project '../PomeloLynx.xcodeproj'
workspace '../PomeloLynx'

require_relative '../pods'
extend PomeloPods

target 'PomeloLynx' do
  use_lynx_library!
  pomelo_pods(devtools: false)
end

post_install do |installer|
  PomeloPods.apply_build_settings(installer)
end
