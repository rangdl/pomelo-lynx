# 私有源是官方参考实现(lynx-family/integrating-lynx-demo-projects,
# ios/HelloLynxSwift)所用的同一个 Specs 仓库:Lynx / LynxBase /
# LynxService / LynxServiceAPI / XElement 全部由它发布;trunk 仍提供
# libwebp / SDWebImage 等公共包。
source 'https://github.com/lynx-family/Specs.git'
source 'https://cdn.cocoapods.org/'

platform :ios, '15.0'

# 本地开发版:带 Inspector(Devtool),bundle id org.pomelo.lynx。
project 'PomeloLynx.xcodeproj'
workspace 'PomeloLynx'

require_relative 'pods'
extend PomeloPods

target 'PomeloLynx' do
  pomelo_pods(devtools: true)
end

post_install do |installer|
  PomeloPods.apply_build_settings(installer)
end
